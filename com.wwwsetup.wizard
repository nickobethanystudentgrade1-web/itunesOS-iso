#!/bin/bash

set -e

OS_NAME="iTunes OS"

OS_VERSION="1.0"

CONFIG_DIR="$HOME/.itunes-os"

CONFIG_FILE="$CONFIG_DIR/system.conf"

clear

echo "======================================"

echo "          Welcome to $OS_NAME"

echo "======================================"

echo

echo "Version: $OS_VERSION"

echo

echo "Press Enter to begin."

read

mkdir -p "$CONFIG_DIR"

clear

echo "STEP 1 OF 6 — Create your account"

echo

read -p "Your name: " USER_NAME

while [ -z "$USER_NAME" ]; do

    echo "Please enter a name."

    read -p "Your name: " USER_NAME

done

clear

echo "STEP 2 OF 6 — Choose a language"

echo

echo "1. English"

echo "2. Filipino"

echo "3. Spanish"

echo "4. French"

echo

read -p "Select [1-4]: " LANGUAGE_CHOICE

case "$LANGUAGE_CHOICE" in

    1) LANGUAGE="English" ;;

    2) LANGUAGE="Filipino" ;;

    3) LANGUAGE="Spanish" ;;

    4) LANGUAGE="French" ;;

    *) LANGUAGE="English" ;;

esac

clear

echo "STEP 3 OF 6 — Region"

echo

read -p "Country/Region: " REGION

[ -z "$REGION" ] && REGION="Philippines"

clear

echo "STEP 4 OF 6 — Network"

echo

echo "You can connect to Wi-Fi later from System Settings."

echo

read -p "Continue? [Y/n]: " NETWORK

if [[ "$NETWORK" =~ ^[Nn]$ ]]; then

    NETWORK_STATUS="Not configured"

else

    NETWORK_STATUS="Configure later"

fi

clear

echo "STEP 5 OF 6 — Privacy"

echo

echo "iTunes OS can use optional diagnostics."

echo

echo "1. Share diagnostics"

echo "2. Don't share diagnostics"

echo

read -p "Select [1-2]: " PRIVACY_CHOICE

case "$PRIVACY_CHOICE" in

    1) DIAGNOSTICS="enabled" ;;

    *) DIAGNOSTICS="disabled" ;;

esac

clear

echo "STEP 6 OF 6 — Finish"

echo

echo "Name:        $USER_NAME"

echo "Language:    $LANGUAGE"

echo "Region:      $REGION"

echo "Network:     $NETWORK_STATUS"

echo "Diagnostics: $DIAGNOSTICS"

echo

read -p "Create this configuration? [Y/n]: " CONFIRM

if [[ "$CONFIRM" =~ ^[Nn]$ ]]; then

    echo

    echo "Setup cancelled."

    exit 0

fi

cat > "$CONFIG_FILE" <<EOF

OS_NAME="$OS_NAME"

OS_VERSION="$OS_VERSION"

USER_NAME="$USER_NAME"

LANGUAGE="$LANGUAGE"

REGION="$REGION"

NETWORK_STATUS="$NETWORK_STATUS"

DIAGNOSTICS="$DIAGNOSTICS"

SETUP_COMPLETE="true"

EOF

touch "$CONFIG_DIR/setup-complete"

clear

echo "======================================"

echo "       iTunes OS Setup Complete"

echo "======================================"

echo

echo "Welcome, $USER_NAME!"

echo

echo "Starting iTunes OS..."

sleep 2